---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Workshops & Tutorials" sideBarActiveItemID="workshops">
  <div>
    <div class="text-3xl w-full font-bold mb-2">Workshops & Tutorials</div>
    <div class="text-lg mb-8 opacity-75">
      Hands-on learning materials from workshops I've taught at Techqueria, Oakland Tech Week, and beyond,
      covering AI fundamentals through advanced RAG and agentic system design.
    </div>
  </div>

  <div>
    <div class="text-2xl w-full font-bold mb-4">AI & Generative AI</div>
  </div>

  <HorizontalCard
    title="GenAI Tutorial: Chatbots, Memory & RAG Systems"
    img="/post_img.webp"
    desc="Hands-on workshop series covering conversational AI with memory, RAG architectures, and production deployment patterns. From LangChain basics to multi-turn agents with retrieval."
    url="https://github.com/techqueria/GenAI-Tutorial"
    badge="RAG"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="OpenAI API Tutorials: GPT Models, Fine-Tuning & Integration"
    img="/post_img.webp"
    desc="Curated labs for working with the OpenAI API, covering prompt engineering, function calling, fine-tuning workflows, and integrating GPT models into real-world applications."
    url="https://github.com/VRamirez-MIDS"
    badge="OpenAI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AI Mastery Hub: Beginner to Expert Learning Path"
    img="/post_img.webp"
    desc="A structured learning path through AI fundamentals, ML concepts, and applied deep learning. Designed for developers entering the AI space without a formal ML background."
    url="https://github.com/VRamirez-MIDS"
    badge="Learning Path"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AI Para Todos: Accessible AI Workshop Series"
    img="/post_img.webp"
    desc="Bilingual workshop series designed to make AI accessible from beginner to advanced levels. Developed for the LatinX tech community through Techqueria and community events."
    url="https://github.com/techqueria/ai-para-todos"
    badge="Community"
  />

  <div>
    <div class="text-2xl w-full font-bold mb-4 mt-10">Architecture & Engineering</div>
  </div>

  <HorizontalCard
    title="Software Architecture Showcase"
    img="/post_img.webp"
    desc="A hands-on collection of software architecture projects demonstrating layered architecture, event-driven systems, CQRS, DDD, and AI-integrated design patterns in production-style code."
    url="https://github.com/VRamirez-MIDS"
    badge="Architecture"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AI vs ML vs DL: The Definitive Guide"
    img="/post_img.webp"
    desc="Educational site clarifying the often-confused distinctions between Artificial Intelligence, Machine Learning, and Deep Learning, with visual explanations and real examples for each paradigm."
    url="https://github.com/VRamirez-MIDS"
    badge="Explainer"
  />
</BaseLayout>
